#!/usr/bin/env bash
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

readonly fixture_hostname="${CERTBATON_FIXTURE_HOSTNAME:-certbaton-fixture.test}"

/usr/sbin/sshd -t -f /etc/ssh/sshd_config
curl --fail --silent --show-error --max-time 2 http://127.0.0.1/healthz >/dev/null
openssl s_client \
    -brief \
    -verify_return_error \
    -verify_hostname "$fixture_hostname" \
    -connect 127.0.0.1:443 \
    -servername "$fixture_hostname" \
    -CAfile /fixture-output/pki/ca.crt \
    </dev/null \
    >/dev/null 2>&1
