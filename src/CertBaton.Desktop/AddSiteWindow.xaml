<Window x:Class="CertBaton.Desktop.AddSiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a website — CertBaton"
        Width="860"
        Height="820"
        MinWidth="760"
        MinHeight="680"
        Background="#F3F5F7"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="#172235" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="BorderBrush" Value="#B9C6D1" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontFamily" Value="Segoe UI Semibold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="#1D5B79" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontFamily" Value="Segoe UI Semibold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="#E7EDF2" />
      <Setter Property="Foreground" Value="#173E5B" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Margin" Value="0,0,0,14" />
      <Setter Property="Padding" Value="22" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D8E0E7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,5" />
      <Setter Property="FontFamily" Value="Segoe UI Semibold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="Help" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,5,0,0" />
      <Setter Property="Foreground" Value="#65788A" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="96" />
      <RowDefinition Height="*" />
      <RowDefinition Height="72" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#102A43">
      <Grid Margin="30,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontFamily="Segoe UI Semibold"
                     FontSize="25"
                     Foreground="White"
                     Text="Add a website" />
          <TextBlock Margin="0,5,0,0"
                     FontSize="13"
                     Foreground="#C9D8E6"
                     Text="Connect, verify, and add it to your certificate inventory." />
        </StackPanel>
        <Border Grid.Column="1"
                Padding="11,6"
                VerticalAlignment="Top"
                Background="#173E5B"
                CornerRadius="4">
          <TextBlock FontFamily="Segoe UI Semibold"
                     FontSize="12"
                     Foreground="#DDEAF3"
                     Text="LET'S ENCRYPT STAGING" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  Padding="28,20,28,10"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="28"
                    Height="28"
                    VerticalAlignment="Top"
                    Background="#1D5B79"
                    CornerRadius="14">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="Segoe UI Semibold"
                         Foreground="White"
                         Text="1" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock FontFamily="Segoe UI Semibold"
                         FontSize="18"
                         Text="Which website are you protecting?" />
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Website name" />
                  <TextBox AutomationProperties.Name="Website name"
                           Text="{Binding SiteName, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Style="{StaticResource Help}"
                             Text="A friendly name, such as Main restaurant website." />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Domain name" />
                  <TextBox AutomationProperties.Name="Domain name"
                           Text="{Binding DomainName, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Style="{StaticResource Help}"
                             Text="The public name visitors use, without https://." />
                </StackPanel>
              </Grid>
              <StackPanel Margin="0,14,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Certificate contact email" />
                <TextBox AutomationProperties.Name="Certificate contact email"
                         Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="28"
                    Height="28"
                    VerticalAlignment="Top"
                    Background="#1D5B79"
                    CornerRadius="14">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="Segoe UI Semibold"
                         Foreground="White"
                         Text="2" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock FontFamily="Segoe UI Semibold"
                         FontSize="18"
                         Text="Connect to your hosting account" />
              <Border Margin="0,12,0,16"
                      Padding="13,10"
                      Background="#EEF5F8"
                      BorderBrush="#BDD5E1"
                      BorderThickness="1"
                      CornerRadius="5">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock FontFamily="Segoe UI Semibold"
                               FontSize="14"
                               Text="SSH with SFTP" />
                    <TextBlock Margin="0,3,20,0"
                               Foreground="#526579"
                               FontSize="12"
                               Text="Secure file transfer and a constrained Nginx activation helper." />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             VerticalAlignment="Center"
                             FontFamily="Segoe UI Semibold"
                             Foreground="#216B4B"
                             Text="AVAILABLE" />
                </Grid>
              </Border>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Hosting server" />
                  <TextBox AutomationProperties.Name="Hosting server address"
                           Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="SSH port" />
                  <TextBox AutomationProperties.Name="SSH port"
                           Text="{Binding SshPortText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="SSH username" />
                  <TextBox AutomationProperties.Name="SSH username"
                           Text="{Binding SshUsername, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="SSH private key" />
                  <TextBox AutomationProperties.Name="SSH private key file"
                           IsReadOnly="True"
                           Text="{Binding PrivateKeyPath}" />
                </StackPanel>
                <Button Grid.Column="2"
                        Margin="0,23,0,0"
                        Style="{StaticResource SecondaryButton}"
                        AutomationProperties.Name="Choose SSH private key file"
                        Click="BrowseKey_Click"
                        Content="Choose file..." />
              </Grid>
              <TextBlock Style="{StaticResource Help}"
                         Text="CertBaton supports unencrypted OpenSSH and PKCS #8 key files in this preview. The test is read-only." />

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button AutomationProperties.Name="Test SSH and SFTP connection"
                        Command="{Binding TestConnectionCommand}"
                        Content="Test connection" />
                <Border Grid.Column="2"
                        Padding="12,9"
                        BorderBrush="#D8E0E7"
                        BorderThickness="1"
                        CornerRadius="4">
                  <StackPanel>
                    <TextBlock FontFamily="Segoe UI Semibold"
                               FontSize="12"
                               Text="Server identity" />
                    <TextBlock Margin="0,3,0,0"
                               FontFamily="Consolas"
                               FontSize="11"
                               Text="{Binding ServerIdentity}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ServerIdentity}" />
                  </StackPanel>
                </Border>
              </Grid>

              <CheckBox Margin="0,14,0,0"
                        IsChecked="{Binding ServerIdentityConfirmed}"
                        IsEnabled="{Binding ConnectionVerified}">
                <TextBlock Text="I confirmed this server identity with my hosting provider or administrator."
                           TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock Margin="0,12,0,0"
                         Foreground="#65788A"
                         FontSize="12"
                         Text="Additional connectors—SSH/SCP, cPanel, Plesk, DirectAdmin, and provider APIs—will appear here as each safe activation contract is implemented."
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="28"
                    Height="28"
                    VerticalAlignment="Top"
                    Background="#1D5B79"
                    CornerRadius="14">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="Segoe UI Semibold"
                         Foreground="White"
                         Text="3" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock FontFamily="Segoe UI Semibold"
                         FontSize="18"
                         Text="Review renewal settings" />
              <TextBlock Margin="0,6,0,0"
                         Foreground="#526579"
                         FontSize="13"
                         Text="This preview uses Let's Encrypt staging so no trusted production certificate will be requested."
                         TextWrapping="Wrap" />

              <Expander Margin="0,14,0,0"
                        Header="Advanced Nginx deployment paths">
                <Grid Margin="0,12,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="HTTP-01 challenge folder" />
                    <TextBox Text="{Binding ChallengeWebroot, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Certificate upload folder" />
                    <TextBox Text="{Binding IncomingRoot, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Active certificate path" />
                    <TextBox Text="{Binding CertificatePath, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Active private-key path" />
                    <TextBox Text="{Binding PrivateKeyRemotePath, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
              </Expander>

              <CheckBox Margin="0,15,0,0"
                        IsChecked="{Binding TermsAccepted}">
                <TextBlock Text="I agree to the current Let's Encrypt terms of service."
                           TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox Margin="0,10,0,0"
                        IsChecked="{Binding AutoRenew}">
                <TextBlock Text="Automatically renew this website after it is added."
                           TextWrapping="Wrap" />
              </CheckBox>
            </StackPanel>
          </Grid>
        </Border>

        <Border Margin="0,0,0,14"
                Padding="16,13"
                Background="White"
                BorderBrush="{Binding StatusBrush}"
                BorderThickness="2"
                CornerRadius="6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="10"
                     Height="10"
                     Margin="0,4,0,0"
                     VerticalAlignment="Top"
                     Fill="{Binding StatusBrush}" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock FontFamily="Segoe UI Semibold"
                         FontSize="14"
                         Text="{Binding StatusTitle}" />
              <TextBlock Margin="0,3,0,0"
                         Foreground="#526579"
                         FontSize="12"
                         Text="{Binding StatusMessage}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Padding="28,14"
            Background="White"
            BorderBrush="#D8E0E7"
            BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center"
                   Foreground="#65788A"
                   FontSize="12"
                   Text="Nothing is saved until you choose Add website." />
        <Button Grid.Column="1"
                Style="{StaticResource SecondaryButton}"
                IsCancel="True"
                Content="Cancel" />
        <Button Grid.Column="3"
                AutomationProperties.Name="Add website to CertBaton inventory"
                Command="{Binding AddSiteCommand}"
                Content="Add website" />
      </Grid>
    </Border>
  </Grid>
</Window>
