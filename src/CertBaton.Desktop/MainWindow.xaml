<Window x:Class="CertBaton.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CertBaton"
        Width="1040"
        Height="760"
        MinWidth="860"
        MinHeight="640"
        Background="#F3F5F7"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="#172235" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="FontFamily" Value="Segoe UI Semibold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="Background" Value="#1D5B79" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="MinWidth" Value="210" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#65788A" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Semibold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="120" />
      <RowDefinition Height="*" />
      <RowDefinition Height="42" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#102A43">
      <Grid Margin="36,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontFamily="Segoe UI Semibold"
                     FontSize="29"
                     Foreground="White"
                     Text="CertBaton" />
          <TextBlock Margin="0,5,0,0"
                     FontSize="14"
                     Foreground="#C9D8E6"
                     Text="Trust at Every Handoff" />
        </StackPanel>
        <Border Grid.Column="1"
                Padding="12,7"
                VerticalAlignment="Top"
                Background="#173E5B"
                CornerRadius="4">
          <TextBlock FontFamily="Segoe UI Semibold"
                     FontSize="12"
                     Foreground="#DDEAF3"
                     Text="DEVELOPER PREVIEW · SIMULATION ONLY" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  Margin="34,-18,34,16"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Padding="24"
                Background="White"
                BorderBrush="#D8E0E7"
                BorderThickness="1"
                CornerRadius="8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="420" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="12"
                         Height="12"
                         Margin="0,4,10,0"
                         VerticalAlignment="Top"
                         Fill="{Binding StatusBrush}" />
                <TextBlock FontFamily="Segoe UI Semibold"
                           FontSize="20"
                           Text="{Binding Status}" />
              </StackPanel>
              <TextBlock Margin="22,7,16,0"
                         FontSize="13"
                         Foreground="#526579"
                         Text="{Binding Summary}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="12,0,24,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="26" />
                <RowDefinition Height="26" />
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource Caption}" Text="Service version" />
              <TextBlock Grid.Column="1"
                         Style="{StaticResource Value}"
                         Text="{Binding ServiceVersion}" />
              <TextBlock Grid.Row="1"
                         Style="{StaticResource Caption}"
                         Text="Service started" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Style="{StaticResource Value}"
                         Text="{Binding ServiceStarted}" />
              <TextBlock Grid.Row="2"
                         Style="{StaticResource Caption}"
                         Text="Last checked" />
              <TextBlock Grid.Row="2"
                         Grid.Column="1"
                         Style="{StaticResource Value}"
                         Text="{Binding LastChecked}" />
            </Grid>

            <Button Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh service and simulation status"
                    Command="{Binding RefreshCommand}"
                    Content="Refresh" />
          </Grid>
        </Border>

        <Border Margin="0,16,0,0"
                Padding="24"
                Background="White"
                BorderBrush="#D8E0E7"
                BorderThickness="1"
                CornerRadius="8">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="18" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="18" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="16" />
              <RowDefinition Height="240" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock FontFamily="Segoe UI Semibold"
                           FontSize="21"
                           Text="Durable renewal simulation" />
                <TextBlock Margin="0,5,20,0"
                           FontSize="13"
                           Foreground="#526579"
                           Text="Exercises the service-owned state machine and evidence trail. No network, ACME, SSH, certificate, or credential operation occurs."
                           TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Choose simulated failure stage"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding FailureChoices}"
                        SelectedItem="{Binding SelectedFailure}" />
              <Button Grid.Column="3"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Start local durable renewal simulation"
                      Command="{Binding StartSimulationCommand}"
                      Content="Run simulation" />
            </Grid>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="450" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="12"
                           Height="12"
                           Margin="0,4,10,0"
                           VerticalAlignment="Top"
                           Fill="{Binding SimulationStatusBrush}" />
                  <TextBlock FontFamily="Segoe UI Semibold"
                             FontSize="19"
                             Text="{Binding SimulationStatus}" />
                </StackPanel>
                <TextBlock Margin="22,6,20,0"
                           FontSize="13"
                           Foreground="#526579"
                           Text="{Binding SimulationSummary}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="25" />
                  <RowDefinition Height="25" />
                  <RowDefinition Height="25" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Caption}" Text="Run ID" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource Value}"
                           Text="{Binding SimulationRunId}" />
                <TextBlock Grid.Row="1"
                           Style="{StaticResource Caption}"
                           Text="Requested" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Style="{StaticResource Value}"
                           Text="{Binding SimulationRequested}" />
                <TextBlock Grid.Row="2"
                           Style="{StaticResource Caption}"
                           Text="Completed" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Style="{StaticResource Value}"
                           Text="{Binding SimulationCompleted}" />
              </Grid>
            </Grid>

            <TextBlock Grid.Row="4"
                       FontFamily="Segoe UI Semibold"
                       FontSize="14"
                       Text="Evidence timeline" />

            <ListView Grid.Row="6"
                      AutomationProperties.Name="Simulation evidence timeline"
                      BorderBrush="#D8E0E7"
                      BorderThickness="1"
                      ItemsSource="{Binding SimulationTimeline}">
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="42"
                                  DisplayMemberBinding="{Binding Sequence}"
                                  Header="#" />
                  <GridViewColumn Width="112"
                                  DisplayMemberBinding="{Binding Stage}"
                                  Header="Stage" />
                  <GridViewColumn Width="92"
                                  DisplayMemberBinding="{Binding Outcome}"
                                  Header="Result" />
                  <GridViewColumn Width="135"
                                  DisplayMemberBinding="{Binding RecordedAt}"
                                  Header="Recorded" />
                  <GridViewColumn Width="390"
                                  DisplayMemberBinding="{Binding Description}"
                                  Header="Evidence" />
                  <GridViewColumn Width="180"
                                  DisplayMemberBinding="{Binding Code}"
                                  Header="Code" />
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="2"
               Margin="36,0"
               VerticalAlignment="Center"
               FontSize="12"
               Foreground="#65788A"
               Text="Pre-alpha: synthetic evidence only. Production renewal, credentials, and live targets remain disabled." />
  </Grid>
</Window>
