<Window x:Class="CertBaton.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CertBaton"
        Width="1120"
        Height="820"
        MinWidth="900"
        MinHeight="680"
        Background="#F3F5F7"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="#172235" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="FontFamily" Value="Segoe UI Semibold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="Background" Value="#1D5B79" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Padding" Value="24" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D8E0E7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#65788A" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Semibold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Metric" TargetType="Border">
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Background" Value="#F6F8FA" />
      <Setter Property="BorderBrush" Value="#E1E7EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="120" />
      <RowDefinition Height="*" />
      <RowDefinition Height="48" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#102A43">
      <Grid Margin="36,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontFamily="Segoe UI Semibold"
                     FontSize="29"
                     Foreground="White"
                     Text="CertBaton" />
          <TextBlock Margin="0,5,0,0"
                     FontSize="14"
                     Foreground="#C9D8E6"
                     Text="Trust at Every Handoff" />
        </StackPanel>
        <Border Grid.Column="1"
                Padding="12,7"
                VerticalAlignment="Top"
                Background="#173E5B"
                CornerRadius="4">
          <TextBlock FontFamily="Segoe UI Semibold"
                     FontSize="12"
                     Foreground="#DDEAF3"
                     Text="PRE-ALPHA &#x00B7; LIVE CLIENT PREVIEW" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  Margin="34,-18,34,16"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="390" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="12"
                         Height="12"
                         Margin="0,4,10,0"
                         VerticalAlignment="Top"
                         Fill="{Binding StatusBrush}" />
                <TextBlock FontFamily="Segoe UI Semibold"
                           FontSize="20"
                           Text="{Binding Status}" />
              </StackPanel>
              <TextBlock Margin="22,7,16,0"
                         FontSize="13"
                         Foreground="#526579"
                         Text="{Binding Summary}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="12,0,24,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="26" />
                <RowDefinition Height="26" />
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource Caption}" Text="Service version" />
              <TextBlock Grid.Column="1"
                         Style="{StaticResource Value}"
                         Text="{Binding ServiceVersion}" />
              <TextBlock Grid.Row="1"
                         Style="{StaticResource Caption}"
                         Text="Service started" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Style="{StaticResource Value}"
                         Text="{Binding ServiceStarted}" />
              <TextBlock Grid.Row="2"
                         Style="{StaticResource Caption}"
                         Text="Last checked" />
              <TextBlock Grid.Row="2"
                         Grid.Column="1"
                         Style="{StaticResource Value}"
                         Text="{Binding LastChecked}" />
            </Grid>

            <Button Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh service, live target, operation, and diagnostic status"
                    Command="{Binding RefreshCommand}"
                    Content="Refresh" />
          </Grid>
        </Border>

        <Border Margin="0,16,0,0" Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="16" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="14" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="16" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="16" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="260" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock FontFamily="Segoe UI Semibold"
                           FontSize="22"
                           Text="Live certificate renewal" />
                <TextBlock Margin="0,5,20,0"
                           FontSize="13"
                           Foreground="#526579"
                           Text="Developer preview: starts a service-owned ACME and SSH deployment workflow for the selected enrolled target."
                           TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1"
                      Padding="10,6"
                      VerticalAlignment="Top"
                      Background="#E8F3ED"
                      CornerRadius="4">
                <TextBlock FontFamily="Segoe UI Semibold"
                           FontSize="12"
                           Foreground="#216B4B"
                           Text="LIVE WORKFLOW" />
              </Border>
            </Grid>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Caption}" Text="Target inventory" />
                <TextBlock Margin="0,3,12,0"
                           Style="{StaticResource Value}"
                           Text="{Binding TargetInventory}" />
              </StackPanel>
              <ComboBox Grid.Column="1"
                        AutomationProperties.Name="Choose an enrolled live renewal target"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding Targets}"
                        SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" />
              <Button Grid.Column="3"
                      AutomationProperties.Name="Start live certificate renewal for selected target"
                      Command="{Binding StartRenewalCommand}"
                      Content="Start renewal" />
            </Grid>

            <StackPanel Grid.Row="4">
              <TextBlock FontSize="13"
                         Foreground="#526579"
                         Text="{Binding SelectedTargetSummary}"
                         TextWrapping="Wrap" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="12"
                         Foreground="#65788A"
                         Text="Enrollment wizard is not included in this increment. Use: certbatonctl target enroll --config &lt;path-to-json&gt;"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="12"
                           Height="12"
                           Margin="0,4,10,0"
                           VerticalAlignment="Top"
                           Fill="{Binding LiveStatusBrush}" />
                  <TextBlock FontFamily="Segoe UI Semibold"
                             FontSize="19"
                             Text="{Binding LiveStatus}" />
                </StackPanel>
                <TextBlock Margin="22,6,24,0"
                           FontSize="13"
                           Foreground="#526579"
                           Text="{Binding LiveSummary}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="105" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="25" />
                  <RowDefinition Height="25" />
                  <RowDefinition Height="25" />
                  <RowDefinition Height="25" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Caption}" Text="Target" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource Value}"
                           Text="{Binding LiveTargetName}" />
                <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="Operation ID" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Style="{StaticResource Value}"
                           Text="{Binding LiveOperationId}" />
                <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="Requested" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Style="{StaticResource Value}"
                           Text="{Binding LiveRequested}" />
                <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Text="Last update" />
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Style="{StaticResource Value}"
                           Text="{Binding LiveUpdated}" />
              </Grid>
            </Grid>

            <Grid Grid.Row="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Metric}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Caption}" Text="Failure code" />
                  <TextBlock Margin="0,3,0,0"
                             Style="{StaticResource Value}"
                             Text="{Binding LiveFailureCode}"
                             ToolTip="{Binding LiveFailureCode}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Metric}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Caption}" Text="Public TLS" />
                  <TextBlock Margin="0,3,0,0"
                             Style="{StaticResource Value}"
                             Text="{Binding LivePublicTls}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Metric}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Caption}" Text="Challenge cleanup" />
                  <TextBlock Margin="0,3,0,0"
                             Style="{StaticResource Value}"
                             Text="{Binding LiveChallengeCleanup}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Margin="0,0,0,10" Style="{StaticResource Metric}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Caption}" Text="Completed" />
                  <TextBlock Margin="0,3,0,0"
                             Style="{StaticResource Value}"
                             Text="{Binding LiveCompleted}" />
                </StackPanel>
              </Border>
              <Border Grid.ColumnSpan="4"
                      Margin="0,65,0,0"
                      Padding="12,9"
                      Background="#F6F8FA"
                      BorderBrush="#E1E7EC"
                      BorderThickness="1"
                      CornerRadius="4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Caption}"
                             Text="Certificate leaf SHA-256" />
                  <TextBlock Grid.Column="1"
                             Style="{StaticResource Value}"
                             Text="{Binding LiveCertificateFingerprint}"
                             ToolTip="{Binding LiveCertificateFingerprint}" />
                </Grid>
              </Border>
            </Grid>

            <TextBlock Grid.Row="9"
                       Margin="0,0,0,8"
                       FontFamily="Segoe UI Semibold"
                       FontSize="14"
                       Text="Evidence timeline" />

            <ListView Grid.Row="10"
                      AutomationProperties.Name="Live renewal evidence timeline"
                      BorderBrush="#D8E0E7"
                      BorderThickness="1"
                      ItemsSource="{Binding LiveTimeline}">
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="42"
                                  DisplayMemberBinding="{Binding Sequence}"
                                  Header="#" />
                  <GridViewColumn Width="105"
                                  DisplayMemberBinding="{Binding Category}"
                                  Header="Category" />
                  <GridViewColumn Width="115"
                                  DisplayMemberBinding="{Binding Action}"
                                  Header="Action" />
                  <GridViewColumn Width="90"
                                  DisplayMemberBinding="{Binding Outcome}"
                                  Header="Result" />
                  <GridViewColumn Width="130"
                                  DisplayMemberBinding="{Binding RecordedAt}"
                                  Header="Recorded" />
                  <GridViewColumn Width="360"
                                  DisplayMemberBinding="{Binding Description}"
                                  Header="Evidence" />
                  <GridViewColumn Width="170"
                                  DisplayMemberBinding="{Binding Code}"
                                  Header="Code" />
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </Border>

        <Expander Margin="0,16,0,0"
                  AutomationProperties.Name="Development simulation diagnostics"
                  Background="White"
                  BorderBrush="#D8E0E7"
                  BorderThickness="1"
                  Header="Development diagnostics: durable renewal simulator"
                  IsExpanded="False">
          <Grid Margin="24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="14" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="14" />
              <RowDefinition Height="220" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Margin="0,0,20,0"
                         FontSize="13"
                         Foreground="#526579"
                         Text="Exercises the durable state machine with synthetic evidence. It does not contact ACME or SSH endpoints."
                         TextWrapping="Wrap" />
              <ComboBox Grid.Column="1"
                        AutomationProperties.Name="Choose simulated failure stage"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding FailureChoices}"
                        SelectedItem="{Binding SelectedFailure}" />
              <Button Grid.Column="3"
                      AutomationProperties.Name="Start local durable renewal simulation"
                      Command="{Binding StartSimulationCommand}"
                      Content="Run simulation" />
            </Grid>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="12"
                           Height="12"
                           Margin="0,4,10,0"
                           VerticalAlignment="Top"
                           Fill="{Binding SimulationStatusBrush}" />
                  <TextBlock FontFamily="Segoe UI Semibold"
                             FontSize="18"
                             Text="{Binding SimulationStatus}" />
                </StackPanel>
                <TextBlock Margin="22,6,20,0"
                           FontSize="13"
                           Foreground="#526579"
                           Text="{Binding SimulationSummary}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="25" />
                  <RowDefinition Height="25" />
                  <RowDefinition Height="25" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Caption}" Text="Run ID" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource Value}"
                           Text="{Binding SimulationRunId}" />
                <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="Requested" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Style="{StaticResource Value}"
                           Text="{Binding SimulationRequested}" />
                <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="Completed" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Style="{StaticResource Value}"
                           Text="{Binding SimulationCompleted}" />
              </Grid>
            </Grid>

            <ListView Grid.Row="4"
                      AutomationProperties.Name="Simulation evidence timeline"
                      BorderBrush="#D8E0E7"
                      BorderThickness="1"
                      ItemsSource="{Binding SimulationTimeline}">
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="42" DisplayMemberBinding="{Binding Sequence}" Header="#" />
                  <GridViewColumn Width="112" DisplayMemberBinding="{Binding Stage}" Header="Stage" />
                  <GridViewColumn Width="92" DisplayMemberBinding="{Binding Outcome}" Header="Result" />
                  <GridViewColumn Width="135" DisplayMemberBinding="{Binding RecordedAt}" Header="Recorded" />
                  <GridViewColumn Width="390" DisplayMemberBinding="{Binding Description}" Header="Evidence" />
                  <GridViewColumn Width="180" DisplayMemberBinding="{Binding Code}" Header="Code" />
                </GridView>
              </ListView.View>
            </ListView>
          </Grid>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="2"
               Margin="36,0"
               VerticalAlignment="Center"
               FontSize="12"
               Foreground="#65788A"
               Text="Pre-alpha developer preview. Live renewals can change remote certificate state; begin with Let&apos;s Encrypt staging and review the evidence." />
  </Grid>
</Window>
