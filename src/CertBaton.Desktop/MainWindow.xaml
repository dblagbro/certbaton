<Window x:Class="CertBaton.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CertBaton"
        Width="820"
        Height="540"
        MinWidth="680"
        MinHeight="460"
        Background="#F3F5F7"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="#172235" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI Semibold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Background" Value="#1D5B79" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="142" />
      <RowDefinition Height="*" />
      <RowDefinition Height="48" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#102A43">
      <Grid Margin="42,26">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontFamily="Segoe UI Semibold"
                   FontSize="30"
                   Foreground="White"
                   Text="CertBaton" />
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   FontSize="15"
                   Foreground="#C9D8E6"
                   Text="Trust at Every Handoff" />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Margin="42,-20,42,22"
            Padding="30"
            Background="White"
            BorderBrush="#D8E0E7"
            BorderThickness="1"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="24" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
          <Ellipse Width="13"
                   Height="13"
                   Margin="0,3,10,0"
                   VerticalAlignment="Top"
                   Fill="{Binding StatusBrush}" />
          <TextBlock FontFamily="Segoe UI Semibold"
                     FontSize="22"
                     Text="{Binding Status}" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="23,9,0,0"
                   FontSize="14"
                   Foreground="#526579"
                   Text="{Binding Summary}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="34" />
            <RowDefinition Height="34" />
          </Grid.RowDefinitions>

          <TextBlock Foreground="#65788A" Text="Service version" />
          <TextBlock Grid.Column="1"
                     FontFamily="Segoe UI Semibold"
                     Text="{Binding ServiceVersion}" />

          <TextBlock Grid.Row="1" Foreground="#65788A" Text="Service started" />
          <TextBlock Grid.Row="1"
                     Grid.Column="1"
                     FontFamily="Segoe UI Semibold"
                     Text="{Binding ServiceStarted}" />

          <TextBlock Grid.Row="2" Foreground="#65788A" Text="Last checked" />
          <TextBlock Grid.Row="2"
                     Grid.Column="1"
                     FontFamily="Segoe UI Semibold"
                     Text="{Binding LastChecked}" />
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal">
          <Button Command="{Binding RefreshCommand}"
                  AutomationProperties.Name="Refresh service status"
                  Content="Refresh status" />
          <TextBlock Margin="14,12,0,0"
                     Foreground="#65788A"
                     Text="Pre-alpha local health channel" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Grid.Row="2"
               Margin="42,0"
               VerticalAlignment="Center"
               FontSize="12"
               Foreground="#65788A"
               Text="No certificate or credential data is exposed through this screen." />
  </Grid>
</Window>
